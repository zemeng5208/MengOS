#!/bin/sh
set -e
# MengOS T5：把 Calamares 默认文件系统改为 btrfs，并让安装后的新用户默认使用 zsh。
# 调查结论（来自 CI，见 docs/STATUS.md / 汇报）：
#   calamares-settings-debian 只提供 /etc/calamares/modules/ 下的 bootloader.conf、fstab.conf、
#   mount.conf、unpackfs.conf 等覆盖项，不含 partition.conf；分区模块的默认配置来自
#   calamares 包本身的 /usr/share/calamares/modules/partition.conf（Calamares 会优先读 /etc 下的同名文件）。
# 因此这里先找到真实存在的 partition.conf，再改 defaultFileSystemType。

echo "=== [T5] Calamares 配置调查（构建时） ==="
echo "--- /etc/calamares/settings.conf ---"
cat /etc/calamares/settings.conf || true
echo "--- ls /etc/calamares/modules/ ---"
ls -l /etc/calamares/modules/ || true
echo "--- ls /usr/share/calamares/modules/（只列本 hook 关心的两个） ---"
ls -l /usr/share/calamares/modules/partition.conf /usr/share/calamares/modules/users.conf 2>/dev/null || true

PCONF=""
for c in /etc/calamares/modules/partition.conf /usr/share/calamares/modules/partition.conf; do
  if [ -f "$c" ]; then PCONF="$c"; break; fi
done
if [ -z "$PCONF" ]; then
  echo "ERROR: 找不到任何 partition.conf" >&2
  find /etc/calamares /usr/share/calamares -name '*.conf' 2>/dev/null | sort >&2 || true
  exit 1
fi
echo "--- 实际使用的 partition.conf: $PCONF ---"
echo "--- 修改前的文件系统相关行 ---"
grep -n 'FileSystem\|filesystem' "$PCONF" || true

if grep -q '^defaultFileSystemType' "$PCONF"; then
  sed -i 's/^defaultFileSystemType:.*/defaultFileSystemType: "btrfs"/' "$PCONF"
else
  echo '（文件中没有 defaultFileSystemType 键，追加一行）'
  echo 'defaultFileSystemType: "btrfs"' >> "$PCONF"
fi
echo "--- 修改后（完成标准要求日志里出现的那一行） ---"
grep -n 'defaultFileSystemType' "$PCONF"

# 安装后的新用户默认 shell 用 zsh（T5 验收 A10 依赖此项）
UCONF=""
for c in /etc/calamares/modules/users.conf /usr/share/calamares/modules/users.conf; do
  if [ -f "$c" ]; then UCONF="$c"; break; fi
done
if [ -n "$UCONF" ]; then
  echo "--- 实际使用的 users.conf: $UCONF ---"
  grep -n 'userShell\|autologin' "$UCONF" || true
  if grep -q '^userShell' "$UCONF"; then
    sed -i 's|^userShell:.*|userShell: /usr/bin/zsh|' "$UCONF"
  else
    echo 'userShell: /usr/bin/zsh' >> "$UCONF"
  fi
  echo "--- 修改后的 userShell ---"
  grep -n 'userShell' "$UCONF"
else
  echo "WARNING: 找不到 users.conf，未设置 userShell"
fi

echo "=== [T5] hook 完成 ==="
