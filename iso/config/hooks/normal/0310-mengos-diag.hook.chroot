#!/bin/sh
# 临时诊断 hook：把 ISO 里与壁纸/剪贴板相关的真实内容打印到构建日志，便于核对（验证完成后删除）。
echo "===== MengOS 诊断开始 ====="

echo "-- 1. 壁纸文件 --"
ls -l /usr/share/backgrounds/mengos/ 2>&1 || echo "缺失"

echo "-- 2. 系统级 xfconf（/etc/xdg）--"
ls -l /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/ 2>&1
grep -n 'last-image\|image-style' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml 2>&1 || echo "无 last-image"

echo "-- 3. 用户级 xfconf（/etc/skel）--"
ls -l /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/ 2>&1 || echo "无 /etc/skel 用户级 xfconf"
grep -n 'last-image' /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml 2>&1 || true

echo "-- 4. 壁纸脚本与自动启动项 --"
ls -l /usr/local/bin/mengos-set-wallpaper /etc/xdg/autostart/mengos-wallpaper.desktop 2>&1 || echo "缺失"

echo "-- 5. SVG 能不能被 gdk-pixbuf 加载（librsvg）--"
dpkg-query -W -f='${Package} ${Version}\n' librsvg2-common librsvg2-2 2>&1 || echo "librsvg 未安装"
ls /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders/ 2>&1 | head -20

echo "-- 6. 桌面快捷方式 --"
ls -l /etc/skel/Desktop/ 2>&1 || echo "无"

echo "-- 7. VMware 剪贴板相关文件 --"
ls -l /etc/xdg/autostart/vmware-user.desktop /usr/bin/vmware-user-suid-wrapper 2>&1 || echo "缺"
ls -l /etc/vmware-tools/xautostart.conf 2>&1 || true

echo "===== MengOS 诊断结束 ====="
exit 0
